{
  "expo": {
    "name": "Eternity",
    "slug": "eternity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eternity",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.joshuat8808.Eternity",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Eternity uses your location to work out real leave-by times and local news for your huddle."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEE8DD",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.joshuat8808.eternity",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Eternity",
      "shortName": "Eternity",
      "description": "A Crew of AI teammates that make the work lighter, not smaller.",
      "themeColor": "#EEE8DD",
      "backgroundColor": "#EEE8DD"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Eternity uses Face ID so nothing gets booked, paid for or sent without you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EEE8DD",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#13161A"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ],
      "expo-mail-composer",
      [
        "expo-calendar",
        {
          "calendarPermission": "Eternity reads your calendar so your Crew can plan around what's already there. Nothing leaves your phone unless you ask.",
          "remindersPermission": "Eternity can read your reminders so your Crew can plan around them."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Eternity looks up a contact only when you ask it to draft a text or email to them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d9c3dc6-ffb6-4054-a157-e84db70d945f"
      }
    },
    "owner": "joshuat8808"
  }
}
