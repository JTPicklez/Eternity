rules_version = '2';
// Shared by Aibram and Eternity (same Firebase project). Deploying rules from
// either repo replaces the project's rules, so keep both apps' rules here.
service cloud.firestore {
  match /databases/{database}/documents {
    // Aibram: each user owns their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Eternity: plan status, written only by the RevenueCat webhook (server).
    // The app may read its own plan; nobody can write it from a phone.
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Eternity: daily message counts, server only. No chat content is ever stored.
    match /usage/{userId} {
      allow read, write: if false;
    }

    // Eternity connectors: encrypted tokens and sign-in states. Server only.
    // The app never reads tokens; it only ever sees results from the functions.
    match /connectorTokens/{id} {
      allow read, write: if false;
    }
    match /connectorStates/{id} {
      allow read, write: if false;
    }

    // Eternity passkeys (website sign-in): public keys and one-time challenges. Server only.
    match /passkeys/{id} {
      allow read, write: if false;
    }
    match /passkeyChallenges/{id} {
      allow read, write: if false;
    }
  }
}
